PORT=4000
DATABASE_URL=postgres://rashko:rashko@localhost:5432/rashko
# Long random string. Required in production.
JWT_SECRET=change-me-to-a-long-random-string
# Where the public website lives (used for payment redirects and CORS)
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Rate limits key on the client IP. Only trust X-Forwarded-For when a proxy you control
# sets it: leave this unset for a directly exposed API, or use the number of proxies in
# front of it (1 behind a single load balancer). Trusting it wrongly lets anyone dodge
# the limits, including the login limit.
TRUST_PROXY=

# Payments. Paste the secret key from your Paystack dashboard and the provider
# switches itself on: sk_test_… = test mode (no real money moves), sk_live_… = live.
# The public key (pk_…) is not needed: checkout uses Paystack's redirect flow.
# Leave both empty for the local demo page (/pay/mock).
PAYSTACK_SECRET_KEY=
# Optional override, normally leave unset: "paystack" or "mock".
# PAYMENT_PROVIDER=
# Only for a production-mode staging deploy, where not charging is intended:
# ALLOW_PAYSTACK_TEST_IN_PROD=true

# WhatsApp. "console" logs messages locally; "cloud" sends them through Meta.
# Cloud needs both values below, from the Meta app's WhatsApp > API Setup page.
WHATSAPP_PROVIDER=console
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Webhook verification + events (used by Meta). Set these when configuring the webhook.
WHATSAPP_VERIFY_TOKEN=rashko_whatsapp_verify_2026
WHATSAPP_APP_SECRET=
# Set to false after first launch to allow customer WhatsApp updates again
HOLD_WHATSAPP_NOTIFICATIONS=true
# Customer order updates are sent as approved utility templates. Each body takes
# {{1}} = customer first name and {{2}} = order code. Rename these if Meta approved
# different names; the language code must match the approved template's language.
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_TEMPLATE_READY=rashko_order_ready
WHATSAPP_TEMPLATE_OUT_FOR_DELIVERY=rashko_order_out_for_delivery
WHATSAPP_TEMPLATE_COMPLETED=rashko_order_completed
WHATSAPP_TEMPLATE_CANCELLED=rashko_order_cancelled

# First admin, created by `npm run seed` (leave empty to get a random password printed once)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
