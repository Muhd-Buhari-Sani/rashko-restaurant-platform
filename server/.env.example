PORT=4000
DATABASE_URL=postgres://rashko:rashko@localhost:5432/rashko
# Long random string. Required in production.
JWT_SECRET=change-me-to-a-long-random-string
# Where the public website lives (used for payment redirects and CORS)
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Rate limits key on the client IP. Only trust X-Forwarded-For when a proxy you control
# sets it: leave this unset for a directly exposed API, or use the number of proxies in
# front of it (1 behind a single load balancer). Trusting it wrongly lets anyone dodge
# the limits, including the login limit.
TRUST_PROXY=

# Payments: "mock" (development, no money moves) or "paystack"
PAYMENT_PROVIDER=mock
PAYSTACK_SECRET_KEY=
# Paystack needs an email; used when the customer gives none
PAYMENT_FALLBACK_EMAIL=orders@example.com

# WhatsApp: "console" (just logs) or "cloud" (Meta WhatsApp Cloud API)
WHATSAPP_PROVIDER=console
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# First admin, created by `npm run seed` (leave empty to get a random password printed once)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
